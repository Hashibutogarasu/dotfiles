{
  "hosts": {
    "github.com": {
      "hostname": "github.com",
      "user": "git",
      "port": 22,
      "identityFile": "~/.ssh/github.pub",
      "identitiesOnly": true
    },
    "example": {
      "hostname": "ssh.example.com",
      "user": "user",
      "identityFile": "~/.ssh/example.pub",
      "identitiesOnly": true,
      "proxyCommand": "cloudflared access ssh --hostname %h"
    }
  }
}
