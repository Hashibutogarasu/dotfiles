{
  "use1Password": true,
  "user": {
    "name": "Your Name",
    "email": "you@example.com",
    "signingKey": "~/.ssh/id_ed25519.pub"
  },
  "directories": [
    {
      "path": "~/sources/example",
      "user": {
        "name": "Work Name",
        "email": "work@example.com",
        "signingKey": "~/.ssh/id_work_ed25519.pub"
      },
      "sshCommand": "ssh -i ~/.ssh/id_work_ed25519 -o IdentitiesOnly=yes"
    }
  ]
}
